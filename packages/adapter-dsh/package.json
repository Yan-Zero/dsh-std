{
  "name": "@dsh-std/adapter-dsh",
  "version": "0.1.1-rc.2",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Yan-Zero/dsh-std.git", "directory": "packages/adapter-dsh" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./profile-loader": {
      "types": "./lib/profile-loader.d.ts",
      "default": "./lib/profile-loader.js"
    },
    "./client": {
      "types": "./lib/client-api.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["lib", "cordis.patch.yml", "CHANGELOG.md"],
  "scripts": {
    "build": "pnpm run typecheck && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter \"@dsh-std/adapter-dsh^...\" build && vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": ">=0.1.2-alpha.2 <0.1.3",
    "@deepseek-ai/dsh-attachment": ">=0.1.2-alpha.2 <0.1.3",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.2 <0.1.3",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.2 <0.1.3",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.2 <0.1.3",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-alpha.2 <0.1.3",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.2-alpha.2 <0.1.3",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-alpha.2 <0.1.3",
    "@deepseek-ai/dsh-client-modules": ">=0.1.2-alpha.2 <0.1.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.2 <0.1.3",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.2-alpha.2 <0.1.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-gateway": { "optional": true },
    "@deepseek-ai/dsh-client-modules": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-tool": { "optional": true },
    "react": { "optional": true }
  },
  "dependencies": {
    "@dsh-std/core": "workspace:^",
    "@dsh-std/manifest": "workspace:^",
    "@dsh-std/composition": "workspace:^",
    "@dsh-std/lifecycle": "workspace:^",
    "@dsh-std/connection": "workspace:^",
    "@dsh-std/command": "workspace:^",
    "@dsh-std/messages": "workspace:^",
    "@dsh-std/model": "workspace:^",
    "@dsh-std/session": "workspace:^",
    "@dsh-std/storage": "workspace:^",
    "@dsh-std/tool": "workspace:^",
    "@dsh-std/ui": "workspace:^",
    "@dsh-std/ui-browser": "workspace:^",
    "@dsh-std/presentation": "workspace:^",
    "@dsh-std/sdk": "workspace:^",
    "@dsh-std/workspace": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-commands": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-modules": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "engines": { "node": "^22.19 || >=24" }
}
